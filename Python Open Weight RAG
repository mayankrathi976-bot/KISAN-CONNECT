from fastapi import FastAPI
from pydantic import BaseModel
import pandas as pd
from langchain_community.vectorstores import FAISS
from langchain_huggingface import HuggingFaceEmbeddings
from langchain_core.documents import Document

class MarketContext(BaseModel):
    crop_name: str
    mandi_name: str
    state: str
    current_modal_price: float
    current_unit: str = "kg"
    arrival_volume_quintals: float
    weather_condition: str
    quantity_kg: float = 100.0

class MandiRAGEngine:
    def __init__(self, csv_path: str = "data/mandi_trends.csv"):
        self.df = pd.read_csv(csv_path)
        docs = [
            Document(
                page_content=f"Crop: {row['crop_name']} at {row['mandi']}. Modal: Rs {row['modal_price']}. Weather: {row['weather_factor']}",
                metadata=row.to_dict()
            )
            for _, row in self.df.iterrows()
        ]
        embeddings = HuggingFaceEmbeddings(model_name="sentence-transformers/all-MiniLM-L6-v2")
        self.vectorstore = FAISS.from_documents(docs, embeddings)

    def predict_income_impact(self, ctx: MarketContext):
        # 1. Retrieve historical trend analogs
        results = self.vectorstore.similarity_search(f"{ctx.crop_name} price trends {ctx.mandi_name}", k=3)
        season_factor = float(results[0].metadata.get("seasonal_index", 1.05))
        
        # 2. Open-Weight Model Ingestion & Income-Centric Formula
        forecast_price = round(ctx.current_modal_price * season_factor, 1)
        gain_per_kg = round(forecast_price - ctx.current_modal_price, 1)
        total_income_change = round(gain_per_kg * ctx.quantity_kg, 2)
        
        # 3. Strict 160-character Bilingual SMS Generator
        sms_en = f"AgriPrice: {ctx.crop_name} {ctx.mandi_name} Rs {ctx.current_modal_price:.0f}. Fcst: Rs {forecast_price:.0f} (+Rs {gain_per_kg:.0f}/kg). Hold 5d. Match: agriprice.in"
        sms_hi = f"किसान भाव: {ctx.mandi_name} {ctx.crop_name} ₹{ctx.current_modal_price:.0f}। अनुमान: ₹{forecast_price:.0f} (+₹{gain_per_kg:.0f}/किग्रा)। सलाह: फसल रोकें। agriprice.in"

        return {
            "current_price": ctx.current_modal_price,
            "forecast_price": forecast_price,
            "gain_per_kg": gain_per_kg,
            "total_income_gain": total_income_change,
            "sms_160_en": sms_en[:160],
            "sms_160_hi": sms_hi[:160]
        }
